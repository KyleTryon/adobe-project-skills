#!/bin/sh
# Runs the whole test suite before anything leaves your machine (CI runs it again).
# Enable once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -I tools/check_private.py --all || exit 1
out=$(python3 -I tests/run_all.py 2>&1) || { printf '%s\n' "$out" | grep -E '^(FAIL|== |   FAILED)|passed'; echo "pre-push: tests failed"; exit 1; }
printf '%s\n' "$out" | tail -1
python3 -I tools/update_roadmap.py --check || exit 1
